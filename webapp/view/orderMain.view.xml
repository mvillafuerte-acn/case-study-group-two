<mvc:View
    controllerName="com.ui5.train.grouptwocasestudy.controller.orderMain"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page title="Order Management">

        <!-- FILTER BAR -->
        <HBox class="sapUiSmallMargin" justifyContent="SpaceBetween" alignItems="End" width="100%" wrap="true">

            <!-- Order Number -->
            <VBox width="32%" class="sapUiSmallMarginEnd">
                <Label text="Order Number"/>
                <Input id="idOrderNumber" placeholder="Order Number"/>
              
            </VBox>

            <!-- Creation Date -->
            <VBox width="32%" class="sapUiSmallMarginEnd">
                <Label text="Creation Date"/>
                <DatePicker id="idCreationDate" displayFormat="yyyy-MM-dd" valueFormat="yyyy-MM-dd" placeholder="Creation Date"/>
            </VBox>

            <!-- Status -->
            <VBox width="32%" class="sapUiSmallMarginEnd">
                <Label text="Status"/>
                <MultiComboBox id="idStatus">
                    <core:Item key="Created" text="Created"/>
                    <core:Item key="Released" text="Released"/>
                    <core:Item key="Partially Completed" text="Partially Completed"/>
                    <core:Item key="Delivered" text="Delivered"/>
                </MultiComboBox>
            </VBox>

            <!-- Buttons horizontal -->
            <HBox width="20%" justifyContent="Start" class="sapUiSmallMarginTop">
                <Button text="Go" press=".onSearch"/>
                <Button text="Clear" press=".onClear" class="sapUiSmallMarginBegin"/>
            </HBox>

        </HBox>

        <!-- ORDERS TABLE -->
        <Table id="idOrdersTable"
               items="{mockOrders>/Orders}"
               mode="MultiSelect"
               growing="true"
               growingScrollToLoad="true"
               class="sapUiSmallMarginTop">

            <headerToolbar>
                <Toolbar>
                    <Title text="Orders"/>
                    <ToolbarSpacer/>
                    <Button icon="sap-icon://add" tooltip="Create" press=".onCreate"/>
                    <Button icon="sap-icon://delete" tooltip="Delete" press=".onDelete"/>
                </Toolbar>
            </headerToolbar>

            <columns>
                <Column><Text text="Order Number"/></Column>
                <Column><Text text="Creation Date"/></Column>
                <Column><Text text="Receiving Plant"/></Column>
                <Column><Text text="Delivering Plant"/></Column>
                <Column><Text text="Status"/></Column>
            </columns>

            <items>
                <ColumnListItem type="Navigation" press=".onItemPress">
                    <cells>
                        <Text text="{mockOrders>OrderNumber}"/>
                        <Text text="{mockOrders>CreationDate}"/>
                        <Text text="{path: 'mockOrders>ReceivingPlant', formatter: 'com.ui5.train.grouptwocasestudy.util.formatter.plantDescription'}"/>
                        <Text text="{path: 'mockOrders>DeliveringPlant', formatter: 'com.ui5.train.grouptwocasestudy.util.formatter.plantDescription'}"/>
                        <Text text="{mockOrders>Status}" 
                              class="{path: 'mockOrders>Status', formatter: 'com.ui5.train.grouptwocasestudy.util.formatter.statusClass'}"/>
                    </cells>
                </ColumnListItem>
            </items>

        </Table>

    </Page>

</mvc:View>
